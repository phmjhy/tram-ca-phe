# SERVER ONLY. Never prefix these with VITE_. Never commit .env or .env.local.
DATABASE_URL=
BETTER_AUTH_SECRET=
# Exact origin, no trailing slash. On Vercel, VERCEL_URL is used if omitted.
APP_ORIGIN=http://127.0.0.1:4176
APP_ENV=development
PORT=4176
# Set POS_USER_EMAIL, POS_USER_PASSWORD, POS_USER_NAME, POS_USER_ROLE privately
# only for npm run user:create. No public signup and no default credentials.
